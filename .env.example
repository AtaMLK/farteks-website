# FARTEKS website SMTP configuration
# Copy this file to .env.local and fill in the real mailbox password.

SMTP_HOST=mail.farteks.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=support@farteks.com
SMTP_PASS=

SMTP_FROM_EMAIL=support@farteks.com
SMTP_FROM_NAME=FARTEKS Website

# Website inquiries are delivered here.
SMTP_TO=info@farteks.com
